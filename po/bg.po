msgstr "Сплескани дръжки"

msgid "Flatten handles for a smoother transition"
msgstr "Плоски дръжки за по-плавен преход"

msgctxt "Operator"
msgid "Bake Sound to F-Curves"
msgstr "Печете звука на Ф-Курвес"

