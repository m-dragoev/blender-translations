msgstr "%s '%s': %s"

msgid "%s '%s' not found"
msgstr "%s '%s' не е намерен"

msgid ""
"Operator '%s' does not have register enabled, incorrect invoke function"
msgstr "Оператор \"%s\" не е включен в регистъра, неточна функция за повикване"

msgid "Operator '%s' does not have undo enabled, incorrect invoke function"
msgstr "Оператор '%s\" не може да се отмени, неточна функция за повикване"

msgid ""
"Operator redo '%s' does not have register enabled, incorrect invoke function"
msgstr ""
"Оператор редо '  ПХ0   ' няма активиран регистър, неправилна функция за "
"повикване"

msgid "Operator redo '%s': wrong context"
