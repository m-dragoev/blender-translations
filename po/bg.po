msgstr "Сума за увеличаване на еластични отскачания за \"еластично\" облекчаване"

msgid "Amount of overshoot for 'back' easing"
msgstr "Размер на превишението за \"обратно\" облекчаване"

msgid ""
"Which ends of the segment between this and the next keyframe easing "
"interpolation is applied to"
msgstr ""
"Към кои краища на сегмента се прилага тази и следващата интерполация за "
"облекчаване на клавиатурата"

msgid "Automatic Easing"
msgstr "Автоматично облекчаване"

msgid "Ease In"
msgstr "Леко"

msgid "Only on the end closest to the next keyframe"
msgstr "Само в края най-близо до следващата клавиатура"

msgid "Ease Out"
msgstr "Спокойно."

msgid "Only on the end closest to the first keyframe"
msgstr "Само в края най-близо до първия ключодържател"

msgid "Ease In and Out"
msgstr "Спокойно."

msgid "Segment between both keyframes"
msgstr "Сегмент между двете клавиатури"

