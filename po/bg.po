msgstr "Имотът трябва да бъде цяло число или плувка"

msgid "Property must be a none, distance, factor, percentage, angle, or pixel"
msgstr "Свойството трябва да бъде нищо, разстояние, фактор, процент, ъгъл или пиксел"
"Имотът трябва да бъде нито едно, разстояние, фактор, процент, ъгъл или "
"пиксел"

msgid ""
"Registering operator class: '%s', invalid bl_idname '%s', at position %d"
msgstr ""
"Клас на оператора за регистриране: \"%s,\" невалидно име '%s', на позиция %d"

msgid ""
"Registering operator class: '%s', invalid bl_idname '%s', is too long, "
"maximum length is %d"
msgstr ""
"Клас на регистриращия оператор: \"  ПХ0  ,\" невалидно бл иднаме ' ПХ1  ,\" "
"е твърде дълъг, максималната дължина е   ПХ2  "

msgid ""
"Registering operator class: '%s', invalid bl_idname '%s', must contain 1 '.'"
" character"
msgstr ""
"Клас на оператора за регистриране: \"  ПХ0  ,\" невалидно име ' ПХ1 ,\" "
"трябва да съдържа 1 \".\""

