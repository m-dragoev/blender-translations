msgstr "Колко материалът се съпротивлява на разтягане"

msgid "Tension Stiffness Maximum"
msgstr "Максимална твърдост при опън"

msgid "Maximum tension stiffness value"
msgstr "Максимална стойност на твърдостта при опън"

