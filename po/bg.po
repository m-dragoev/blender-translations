msgstr "Колко материалът се съпротивлява на срязване"

msgid "Shear Stiffness Maximum"
msgstr "Максимална твърдост при срязване"

msgid "Maximum shear scaling value"
msgstr "Максимална стойност на твърдостта при срязване"

msgid "Shrink Factor Max"
msgstr "Максимален коефициент на свиване"

msgid "Max amount to shrink cloth by"
msgstr "Максимална стойност за свиване на плата"

msgid "Shrink Factor"
msgstr "Коефициент на свиване"

msgid "Factor by which to shrink cloth"
