msgstr "Автоматични дръжки, които създават прави линии"

msgid "Automatic handles that create smooth curves"
msgstr "Автоматични дръжки, които създават гладки криви"

msgid "Auto Clamped"
msgstr "Автоматично затваряне"

msgid ""
"Automatic handles that create smooth curves which only change direction at "
"keyframes"
msgstr ""
"Автоматични дръжки, които създават гладки криви, които само променят "
"посоката си в ключови рамки"

msgid "Right Handle"
msgstr "Дясна дръжка"

