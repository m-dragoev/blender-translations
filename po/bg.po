msgstr "Триене на целта (целева позиция на връх)"

msgid "Goal Maximum"
msgstr "Максимална цел"

msgid "Goal maximum, vertex group weights are scaled to match this range"
msgstr "Целевият максимум, теглата на групите върхове се мащабират, за да съответстват на този диапазон"
