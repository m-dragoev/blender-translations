msgid "Shear Spring Damping"
msgstr "Затихване на пружината при срязване"

msgid "Amount of damping in shearing behavior"
msgstr "Количество затихване при срязване"

msgid "Shear Stiffness"
msgstr "Твърдост при срязване"

